{
  "name": "Gestora 360 — Plataforma de gestión empresarial",
  "short_name": "Gestora 360",
  "description": "Gestión empresarial: importaciones, compras, inventario, ventas, facturación, consultas, reportes, clientes, proveedores y gastos operativos sin inventario.",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#f4f7f5",
